# Needed by seed.py, main.py, and the dashboard's add-a-restaurant search.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NTFY_TOPIC=pick-a-unique-topic-name
CLOSING_SOON_CHECK_EVERY=4
CHECK_LOG_RETAIN_DAYS=90

# Where the "restaurants to verify" notification links to. Only used in that
# notification, so it only matters if you read it on a phone.
DASHBOARD_URL=http://127.0.0.1:5000

# Dashboard (optional) -- signs the session cookie the CSRF token lives in.
# Unset is fine: a key is generated per process, and the only cost is that
# an open page needs a reload after the server restarts.
DASHBOARD_SECRET_KEY=any_long_random_string

# Email notifications (optional -- leave unset to skip email and use ntfy only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=example@gmail.com
EMAIL_TO=test@gmail.com
