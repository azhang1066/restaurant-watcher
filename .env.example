# Needed by seed.py, main.py, and the dashboard's add-a-restaurant search.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Required: ntfy topics are public, so pick a long unguessable name. Pushes are not sent while this is unset or still the placeholder.
NTFY_TOPIC=pick-a-unique-topic-name
CLOSING_SOON_CHECK_EVERY=4
# Optional: override the Claude model used for the news check.
# CLOSURE_CHECK_MODEL=claude-sonnet-5-5
CHECK_LOG_RETAIN_DAYS=90

# Database backups kept in data/backups/ (one per run). 0 disables.
BACKUPS_KEPT=8

# Where the "restaurants to verify" notification links to. Only used in that
# notification, so it only matters if you read it on a phone.
DASHBOARD_URL=http://127.0.0.1:5000

# Dashboard (optional) -- signs the session cookie the CSRF token lives in.
# Unset is fine: a key is generated per process, and the only cost is that
# an open page needs a reload after the server restarts.
DASHBOARD_SECRET_KEY=any_long_random_string

# Email notifications (optional -- leave unset to skip email and use ntfy only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=example@gmail.com
EMAIL_TO=test@gmail.com

# Optional dead-man's switch: a push-monitor URL (healthchecks.io, Uptime Kuma).
# Pinged after every completed run (and at /fail when every check failed), so
# the monitor alerts you if the scheduler stops running altogether.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# Optional: where the rotating log file goes (default data/restaurant-watcher.log),
# or "off" for stderr only.
# LOG_FILE=data/restaurant-watcher.log

# Optional: keep the database somewhere other than data/restaurants.db.
# RESTAURANT_DB_PATH=/path/to/restaurants.db
